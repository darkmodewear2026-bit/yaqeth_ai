<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>يقظ - Yaqeth AI</title>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow/tfjs"></script>
    <script src="https://cdn.jsdelivr.net/npm/@tensorflow-models/face-landmarks-detection"></script>
    
    <style>
        /* التصميم العام (الوضع الليلي) */
        body { background: #050505; color: #fff; font-family: 'Segoe UI', Tahoma, sans-serif; text-align: center; margin: 0; padding: 0; }
        #video { width: 100%; max-width: 500px; border-radius: 20px; border: 3px solid #38bdf8; transform: scaleX(-1); margin-top: 20px; }
        
        /* القائمة الجانبية */
        .menu { position: fixed; top: 15px; left: 20px; font-size: 30px; cursor: pointer; color: #38bdf8; }
        .sidebar { display: none; position: fixed; top: 0; left: 0; width: 250px; height: 100%; background: #111; padding: 20px; box-shadow: 2px 0 10px rgba(0,0,0,0.5); z-index: 1000; }
        .btn { display: block; background: #222; color: #fff; margin: 15px 0; padding: 15px; border-radius: 10px; cursor: pointer; text-decoration: none; border: 1px solid #444; }
        .btn:hover { background: #38bdf8; color: #000; }
    </style>
</head>
<body>

    <div class="menu" onclick="toggleMenu()">☰</div>

    <div id="sidebar" class="sidebar">
        <h2 onclick="toggleMenu()" style="cursor: pointer;">إغلاق ×</h2>
        <a class="btn">1. السائق الخاص (مجاني)</a>
        <a class="btn">2. سائق الشاحنات (اشتراك)</a>
        <a class="btn">3. التاكسي (اشتراك)</a>
        <a class="btn">4. النقل الجماعي (اشتراك)</a>
    </div>

    <h1>نظام يقظ الذكي</h1>
    <video id="video" autoplay playsinline></video>
    <p id="status">جاري تشغيل الكاميرا...</p>

    <script>
        function toggleMenu() {
            const side = document.getElementById('sidebar');
            side.style.display = (side.style.display === 'block') ? 'none' : 'block';
        }

        // تشغيل الكاميرا
        async function startCamera() {
            try {
                const video = document.getElementById('video');
                const stream = await navigator.mediaDevices.getUserMedia({ video: true });
                video.srcObject = stream;
                document.getElementById('status').innerText = "✅ النظام يعمل - يقظ يراقبك";
            } catch (err) {
                document.getElementById('status').innerText = "❌ تعذر الوصول للكاميرا";
            }
        }
        startCamera();
    </script>
</body>
</html>